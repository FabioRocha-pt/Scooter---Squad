# Scooter & Quad · alojamento Aruba (Apache)
# Redirecionamentos 301 das páginas do WordPress antigo (?page_id=N) para o site novo.
# O idioma passa como ?lang=xx, que o app.js lê.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# https/www: ativar no painel Aruba, não aqui (o proxy da Aruba à frente faz %{HTTPS} parecer sempre off)

# Home
RewriteCond %{QUERY_STRING} (^|&)page_id=267(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=pt [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=262(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=en [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=57(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=it [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=969(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=fr [R=301,L,QSD]

# Serviços
RewriteCond %{QUERY_STRING} (^|&)page_id=310(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=pt#servicos [R=301,L,QSD,NE]
RewriteCond %{QUERY_STRING} (^|&)page_id=302(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=en#servicos [R=301,L,QSD,NE]
RewriteCond %{QUERY_STRING} (^|&)page_id=40(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=it#servicos [R=301,L,QSD,NE]
RewriteCond %{QUERY_STRING} (^|&)page_id=964(&|$)
RewriteRule ^(index\.php)?$ /index.html?lang=fr#servicos [R=301,L,QSD,NE]

# Vendas / usados
RewriteCond %{QUERY_STRING} (^|&)page_id=297(&|$)
RewriteRule ^(index\.php)?$ /usados.html?lang=pt [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=292(&|$)
RewriteRule ^(index\.php)?$ /usados.html?lang=en [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=154(&|$)
RewriteRule ^(index\.php)?$ /usados.html?lang=it [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=959(&|$)
RewriteRule ^(index\.php)?$ /usados.html?lang=fr [R=301,L,QSD]

# São Vicente
RewriteCond %{QUERY_STRING} (^|&)page_id=340(&|$)
RewriteRule ^(index\.php)?$ /mindelo.html?lang=pt [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=335(&|$)
RewriteRule ^(index\.php)?$ /mindelo.html?lang=en [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=130(&|$)
RewriteRule ^(index\.php)?$ /mindelo.html?lang=it [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=954(&|$)
RewriteRule ^(index\.php)?$ /mindelo.html?lang=fr [R=301,L,QSD]

# Santiago
RewriteCond %{QUERY_STRING} (^|&)page_id=437(&|$)
RewriteRule ^(index\.php)?$ /praia.html?lang=pt [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=432(&|$)
RewriteRule ^(index\.php)?$ /praia.html?lang=en [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=99(&|$)
RewriteRule ^(index\.php)?$ /praia.html?lang=it [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=934(&|$)
RewriteRule ^(index\.php)?$ /praia.html?lang=fr [R=301,L,QSD]

# Reservar
RewriteCond %{QUERY_STRING} (^|&)page_id=320(&|$)
RewriteRule ^(index\.php)?$ /pedido.html?lang=pt [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=315(&|$)
RewriteRule ^(index\.php)?$ /pedido.html?lang=en [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=148(&|$)
RewriteRule ^(index\.php)?$ /pedido.html?lang=it [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=929(&|$)
RewriteRule ^(index\.php)?$ /pedido.html?lang=fr [R=301,L,QSD]

# Sobre nós
RewriteCond %{QUERY_STRING} (^|&)page_id=393(&|$)
RewriteRule ^(index\.php)?$ /sobre.html?lang=pt [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=388(&|$)
RewriteRule ^(index\.php)?$ /sobre.html?lang=en [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=30(&|$)
RewriteRule ^(index\.php)?$ /sobre.html?lang=it [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)page_id=924(&|$)
RewriteRule ^(index\.php)?$ /sobre.html?lang=fr [R=301,L,QSD]

# qualquer outro endereço antigo do WordPress vai para a home
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-login\.php|xmlrpc\.php)(/.*)?$ / [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)(page_id|p)=[0-9]+ [OR]
RewriteCond %{QUERY_STRING} (^|&)lang=(pt|en|it|fr)(&|$)
RewriteCond %{REQUEST_URI} ^/(index\.php)?$
RewriteRule ^ /index.html [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>
